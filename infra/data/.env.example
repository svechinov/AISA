# Шаблон серверного .env для VPS. На сервере копируется в infra/data/.env и заполняется
# значениями; сам .env в git не попадает никогда (инцидент 09.06: провайдер авто-отозвал
# OpenAI-ключ после пуша в приватный репозиторий).
#
# Файл монтируется в контейнер как /app/data/.env (AI_BIZ_OS_DOTENV) и грузится с override=True —
# значения отсюда бьют environment из compose.

# --- База ---------------------------------------------------------------------------------------
# Четыре слэша = абсолютный путь внутри контейнера. База лежит в bind-каталоге data/ и переживает
# пересборку образа. Postgres на этом инстансе не поднимается (пилот на SQLite).
DATABASE_URL=sqlite:////app/data/ai_biz_os.db

# --- Вход в UI ----------------------------------------------------------------------------------
# Единый пароль на весь инстанс (ролей пока нет). SECRET_KEY — подпись сессий, любая длинная
# случайная строка: openssl rand -hex 32
GLOBAL_PASSWORD=
SECRET_KEY=

# --- LLM ----------------------------------------------------------------------------------------
LLM_PROVIDER_PRIORITY=openai
OPENAI_API_KEY=

# --- Прокси (ОБЯЗАТЕЛЕН на этом сервере) --------------------------------------------------------
# Проверено 06.09.2026 с 194.58.102.98: api.openai.com -> 403, api.tavily.com -> 403. Прямых
# запросов из РФ провайдеры не принимают.
#
# Переменная работает на два фронта сразу: llm_gateway читает её как settings.HTTP_PROXY
# (llm_gateway.py:252), а httpx-клиенты остальных интеграций (Tavily, extract) подхватывают её же
# из окружения процесса. Если прокси только https-схемы, продублируйте в HTTPS_PROXY.
HTTP_PROXY=
HTTPS_PROXY=

# --- Поиск / обогащение -------------------------------------------------------------------------
TAVILY_API_KEY=

# --- Вложения (Cloudflare R2) -------------------------------------------------------------------
# Нужны, только если к письмам прикладываются PDF программ. Экспортный канал FG обходится без них
# (менеджеры шлют сами), поэтому на первом этапе можно оставить пустыми.
CDN_PROVIDER=
CDN_ACCOUNT_ID=
CDN_API_KEY=
CDN_R2_BUCKET=
CDN_R2_ACCESS_KEY_ID=
CDN_R2_SECRET_ACCESS_KEY=
CDN_R2_PUBLIC_BASE_URL=

# --- Прочее -------------------------------------------------------------------------------------
APP_ENV=prod
DEBUG=false
# Транспорт писем в фазе не участвует (экспортный канал: XLSX -> менеджеры FG). Gmail-переменные
# намеренно не заполняются — пустой sender_signature_html у FG-пресета дополнительно блокирует
# отправку движком.
