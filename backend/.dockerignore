# Контекст сборки backend-образа. Без этого файла docker тащит на демон venv (сотни МБ),
# снапшоты БД и кэш тестов — при сборке на VPS это минуты ожидания на ровном месте.
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Снапшоты и рабочие БД: на сервере база живёт в bind-каталоге data/, а не в образе.
*.db
*.sqlite3

# Секреты: .env на сервере лежит в data/.env и монтируется, в образ не попадает никогда.
.env
.env.*
!.env.example

# Тесты в рантайме не нужны (гоняются на машине разработчика до деплоя).
tests/

# Выгрузки черновиков для менеджеров (Фаза 2, Task 4).
exports/
