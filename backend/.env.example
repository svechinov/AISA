# Copy to .env and fill in. Never commit .env.
#
# Location:
# - Local: prefer ai-biz-os/backend/.env (and optionally ai-biz-os/.env — backend wins on conflicts).
# - Docker: infra/docker-compose.yml uses env_file: ../backend/.env so this file on the host is injected;
#   optionally mount the same file as /app/.env inside the container.
# - Override path: export AI_BIZ_OS_DOTENV=/absolute/path/.env

APP_ENV=dev

# Database & Redis (defaults match docker compose in infra/)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_biz_os
REDIS_URL=redis://localhost:6379/0

# --- LLM (configure at least one provider) ---
# Priority order is stored when using the UI setup wizard (first = tried first).
LLM_PROVIDER_PRIORITY=claude,openai,perplexity,grok
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
# Optional overrides (defaults match config.py)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# OPENAI_MODEL=gpt-4o
# PERPLEXITY_MODEL=sonar
# XAI_MODEL=grok-2-latest

# --- CDN / edge storage (provider + shared secret; you may need extra keys per vendor in production) ---
CDN_PROVIDER=
# cloudflare | akamai | cloudfront | gcp_cdn
CDN_API_KEY=

# Allow the browser setup wizard to write this file (local dev only; keep false in production)
ALLOW_SETUP_ENV_WRITE=true
