# Copy to .env and fill in. Never commit .env.
#
# Location:
# - Local: prefer ai-biz-os/backend/.env (and optionally ai-biz-os/.env — backend wins on conflicts).
# - Docker: compose uses env_file to inject this file into the process. Optionally bind-mount the same file to /app/.env
#   in infra/docker-compose.yml so OAuth can append GOOGLE_REFRESH_TOKEN to the host file (needs Docker file-sharing for that path).
# - Override path: export AI_BIZ_OS_DOTENV=/absolute/path/.env

APP_ENV=dev
# APP_NAME=AI Biz OS
# Bearer token for every API call (see main.py AuthMiddleware). Empty = auth disabled (local dev only).
# GLOBAL_PASSWORD=
# Outbound HTTP proxy for LLM/search calls blocked from your network (e.g. LLM providers from RU).
# HTTP_PROXY=
# Skip ensure_schema() at boot (schema already applied by another process/deploy step). Leave unset normally.
# AI_BIZ_OS_SCHEMA_ALREADY_APPLIED=

# Database & Redis (defaults match docker compose in infra/). REDIS_URL is accepted but currently
# unused by any code path — kept for forward compatibility, safe to leave at the default.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_biz_os
REDIS_URL=redis://localhost:6379/0

# --- LLM (configure at least one provider) ---
# Priority order is stored when using the UI setup wizard (first = tried first).
LLM_PROVIDER_PRIORITY=claude,gemini,openai,perplexity,grok
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
# Per-tier models. The gateway routes each task to a tier (cheap|standard|strong|research) and
# picks the provider model by tier — overridable here without a rebuild. Defaults match config.py.
# ANTHROPIC_MODEL=claude-sonnet-5            # standard tier (default for unmarked tasks)
# ANTHROPIC_MODEL_STRONG=claude-opus-4-8     # strong: outreach reasoning/draft + email critic
# ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5     # cheap-tier fallback when Gemini is unavailable
# GEMINI_MODEL=gemini-flash-latest           # cheap tier primary; verify id via GET /v1beta/models
# OPENAI_MODEL=gpt-4o
# PERPLEXITY_MODEL=sonar
# XAI_MODEL=grok-2-latest
# Kimi via Ollama Cloud, Anthropic-compatible endpoint. All three optional — only needed to route
# any task to the "kimi" provider.
# OLLAMA_ANTHROPIC_BASE_URL=https://ollama.com
# OLLAMA_ANTHROPIC_TOKEN=
# KIMI_MODEL=kimi-k2.7-code

# --- Web search (OSINT dossiers, discovery, vacancy radar) ---
# Comma-ordered providers; first configured+answering wins. Tavily first for global/English
# campaigns; put yandex first for RU-focused runs (real yandex.ru index — sees VK/Telegram/regional
# RU press that the US-indexed Tavily misses).
SEARCH_PROVIDER_PRIORITY=tavily,yandex
TAVILY_API_KEY=
# YANDEX_SEARCH_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_SEARCH_REGION=225
# YANDEX_HTTP_TIMEOUT_SEC=40

# --- Firmographics (optional — gates the deterministic ICP size-filter) ---
# Dadata: employee_count from FNS ССЧ, OKVED, INN (needs Расширенный tier for employee_count).
# Free egrul_free fallback needs no key.
# DADATA_API_KEY=
# DADATA_HTTP_TIMEOUT_SEC=10
# FIRMOGRAPHICS_PROVIDER_PRIORITY=dadata,egrul_free

# --- OSINT enrichment / vacancy radar ---
# Cap how many companies enrich_crm_data processes per run (dossier + vacancy radar). Empty = no cap.
# OSINT_MAX_COMPANIES=
# Vacancy radar (open-roles intent signal, careers page -> ATS -> LinkedIn -> web) is on by default.
# VACANCY_RADAR_ENABLED=true
# VACANCY_RADAR_MAX_COMPANIES=

# --- CDN / edge storage (provider + shared secret; you may need extra keys per vendor in production) ---
CDN_PROVIDER=
# cloudflare | akamai | cloudfront | gcp_cdn
CDN_API_KEY=
#
# Cloudflare R2 — required for Human UI «Add file» (arbitrary PDFs etc.). Create R2 API token with Object Read & Write.
# Public URL = custom domain or R2 dev URL, must match how objects are served (no trailing slash).
# CDN_R2_SECRET_ACCESS_KEY can be omitted if CDN_API_KEY already holds the R2 secret access key.
CDN_ACCOUNT_ID=
CDN_R2_BUCKET=
CDN_R2_ACCESS_KEY_ID=
# CDN_R2_SECRET_ACCESS_KEY=
CDN_R2_PUBLIC_BASE_URL=
# optional cap for multipart uploads (default 50)
# CDN_UPLOAD_MAX_BYTES_MB=50
#
# Without R2: Cloudflare Images accepts image/* only (same CDN_ACCOUNT_ID + CDN_API_KEY).

# Allow the browser setup wizard to write this file (local dev only; keep false in production)
ALLOW_SETUP_ENV_WRITE=true

# --- Outbound email transport ---
# "gmail" (Gmail API via OAuth) or "smtp" (rotator over smtp_accounts + SystemSetting Yandex
# fallback). The other transport remains a fallback in email_provider regardless of this setting.
EMAIL_PROVIDER=gmail

# --- Gmail (single mailbox; optional OAuth) ---
# In the SAME Google Cloud project as the OAuth client below, enable the Gmail API:
#   APIs & Services → Library → search "Gmail API" → Enable
# (Otherwise OAuth works but calls to gmail.googleapis.com return 403 SERVICE_DISABLED.)
# OAuth scopes used by the app: https://www.googleapis.com/auth/gmail.send
#   and https://www.googleapis.com/auth/gmail.modify (read + labels + send-side operations).
# Add both under APIs & Services → OAuth consent screen → Scopes, then reconnect if you change scopes.
# Create an OAuth 2.0 Web client in Google Cloud Console. Authorized redirect URI must match how the UI is opened:
#   {origin}/api/oauth/google/callback   e.g. http://localhost:5173/api/oauth/google/callback (Vite proxies /api → API)
# Override only if your reverse proxy uses a different callback path:
# GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Written after "Connect Gmail" when ALLOW_SETUP_ENV_WRITE=true. Docker needs ../backend/.env mounted at /app/.env or the token stays only in the container layer.
GOOGLE_REFRESH_TOKEN=
# CLI (client id/secret already in .env): cd backend && python scripts/fetch_google_refresh_token.py
# Register redirect http://127.0.0.1:8765/oauth2/callback on the same OAuth Web client (see script header).
# Optional; defaults to a hash of DATABASE_URL if unset (set explicitly in multi-instance deployments):
# OAUTH_STATE_SECRET=
#
# "Send mail as" (same Gmail account / OAuth): optional From address. It must appear EXACTLY in Gmail under
# Settings → See all settings → Accounts and import → Send mail as (added + verified). POP/SMTP-only accounts
# do not count until added there. Debug: GET /setup/gmail-send-as-list after connecting Gmail.
# GMAIL_SEND_AS_EMAIL=you@company.com

# --- Gmail: additional mailboxes / domain-wide delegation (optional, multi-sender only) ---
# One extra OAuth-connected mailbox per key. SLUG = the mailbox address, uppercased, non-alnum -> "_"
# (stepan@alexstaff.agency -> GMAIL_ACCOUNT__STEPAN_ALEXSTAFF_AGENCY). Falls back to the global
# GOOGLE_REFRESH_TOKEN/GMAIL_SEND_AS_EMAIL above when a mailbox has no entry of its own.
# GMAIL_ACCOUNT__<SLUG>={"send_as": "name@yourdomain.com", "refresh_token": "1//..."}
#
# Alternative to per-mailbox OAuth: a Workspace service account with domain-wide delegation, so any
# mailbox on an eligible domain works without its own consent screen. GOOGLE_SA_KEY_FILE takes
# priority over GOOGLE_SA_KEY_JSON when both are set.
# GOOGLE_SA_KEY_FILE=/app/data/sa-key.json
# GOOGLE_SA_KEY_JSON={"client_email": "...", ...}
# GOOGLE_DWD_DELEGATED_DOMAINS=yourdomain.com

# Background Gmail sync (threads + bounces): interval in seconds. Set 0 to disable; use POST /gmail-sync/* from cron instead.
# GMAIL_SYNC_INTERVAL_SECONDS=120

# --- Email attachments (program PDFs etc.) ---
# MAX_EMAIL_ATTACHMENT_BYTES=26214400
# MAX_TOTAL_EMAIL_ATTACHMENTS_BYTES=52428800
# Local directory for on-disk assets (relative attachment keys resolve under this root).
# ASSET_STORAGE_ROOT=
# ATTACHMENT_URL_FETCH_TIMEOUT=30

# --- Ops scripts (scripts/*.py at repo root — not read by the backend app itself) ---
# Server IP used by check_db_counts.py / approve_contacts.py / list_rules.py / migrate_run_setup.py (SSH)
# and check_run_status.py / check_contacts.py / verify_e2e_results.py / run_full_pipeline.py /
# generate_emails_only.py / test_api_import.py (HTTP API). Falls back to the current server IP if unset.
# VDS_HOST=<your-server-ip>
# SSH password for the paramiko-based scripts above.
# VDS_PASS=

# collect_companies: verify each proposed website with an HTTP GET (stream prefix). Drops rows that do not respond.
# COLLECT_COMPANIES_HTTP_CHECK_ENABLED=true
# COLLECT_COMPANIES_HTTP_TIMEOUT_SEC=8
# COLLECT_COMPANIES_HTTP_MAX_WORKERS=8

# --- Apollo.io (optional) — when set, collect_companies / find_contacts use Apollo instead of the LLM for discovery.
# Master API key from Apollo Settings → API. Env alias: APOLLO_KEY also works.
# APOLLO_API_KEY=
# APOLLO_HTTP_TIMEOUT_SEC=45
# APOLLO_MAX_ORG_PAGE_SIZE=50
# APOLLO_MAX_PEOPLE_PER_COMPANY=8
# APOLLO_MAX_PEOPLE_TOTAL=120

# --- Outbound email behaviour ---
# false: do not fake-deliver (recommended — errors if Gmail is not configured). true: mock provider without Gmail (offline only).
EMAIL_ALLOW_MOCK=false
# Legacy: shown in setup/status; Drafts → Test sends To = From (GMAIL_SEND_AS_EMAIL or primary Gmail), not this variable.
# GMAIL_PREVIEW_RECIPIENT_EMAIL=

# --- Email address verification (optional — empty provider = MX-only: syntax + domain MX lookup) ---
# EMAIL_VERIFIER_PROVIDER=          # millionverifier | zerobounce
# EMAIL_VERIFIER_API_KEY=
# EMAIL_VERIFIER_HTTP_TIMEOUT_SEC=20

# --- Send queue (approved drafts release on cadence/caps; see sending_policies for per-mailbox
# windows/caps/warmup — those live in the DB, not here) ---
# 0 = worker disabled (kill-switch; manual POST /sending/drafts/{id}/send still works). Keep 0
# until the queue is verified end-to-end for a new deployment.
SEND_QUEUE_INTERVAL_SECONDS=0
# Local hour (per sending_policy timezone) the daily "what did/didn't go out" digest fires. Default 21.
# OUTREACH_DIGEST_HOUR_LOCAL=21

# --- CAN-SPAM ---
# Physical postal address substituted into any persona signature that references it. Required
# before send is unblocked for a persona whose signature needs it (currently only the US track).
# CAN_SPAM_POSTAL_ADDRESS=

# --- Telegram (notifications + optional inbound bridge; one bot + one supergroup with forum topics) ---
# TELEGRAM_BOT_TOKEN=            # from @BotFather. Alias: OUTREACH_TG_BOT_TOKEN
# TELEGRAM_GROUP_CHAT_ID=        # supergroup (forum) id, negative -100...
# TELEGRAM_OWNER_CHAT_ID=        # owner DM chat id — notification fallback + always-allowed poller sender. Alias: OUTREACH_TG_CHAT_ID
# TELEGRAM_TOPICS=               # project->message_thread_id map, e.g. "AI-Biz-OS:2,Content:5,General:1"
# TELEGRAM_POLLER_ENABLED=false  # inbound long-poll bridge; notifications work regardless of this
# TELEGRAM_POLL_TIMEOUT_SEC=25
# TELEGRAM_INBOX_DIR=            # empty = <data dir>/telegram_inbox
# TELEGRAM_VOICE_TRANSCRIBE=true # needs OPENAI_API_KEY (Whisper)
# VOICE_TRANSCRIBE_MODEL=whisper-1
# VOICE_TRANSCRIBE_LANGUAGE=ru   # empty = auto-detect
# Periodic status.json snapshot for the read-only dialog agent (GET /ops/summary aggregation). 0 = disabled.
# STATUS_SNAPSHOT_INTERVAL_SECONDS=180
