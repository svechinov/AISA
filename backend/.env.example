# Copy to .env and fill in. Never commit .env.
#
# Location:
# - Local: prefer ai-biz-os/backend/.env (and optionally ai-biz-os/.env — backend wins on conflicts).
# - Docker: compose uses env_file to inject this file into the process. Optionally bind-mount the same file to /app/.env
#   in infra/docker-compose.yml so OAuth can append GOOGLE_REFRESH_TOKEN to the host file (needs Docker file-sharing for that path).
# - Override path: export AI_BIZ_OS_DOTENV=/absolute/path/.env

APP_ENV=dev

# Database & Redis (defaults match docker compose in infra/)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_biz_os
REDIS_URL=redis://localhost:6379/0

# --- LLM (configure at least one provider) ---
# Priority order is stored when using the UI setup wizard (first = tried first).
LLM_PROVIDER_PRIORITY=claude,openai,perplexity,grok
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
# Optional overrides (defaults match config.py)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# OPENAI_MODEL=gpt-4o
# PERPLEXITY_MODEL=sonar
# XAI_MODEL=grok-2-latest

# --- CDN / edge storage (provider + shared secret; you may need extra keys per vendor in production) ---
CDN_PROVIDER=
# cloudflare | akamai | cloudfront | gcp_cdn
CDN_API_KEY=
#
# Cloudflare R2 — required for Human UI «Add file» (arbitrary PDFs etc.). Create R2 API token with Object Read & Write.
# Public URL = custom domain or R2 dev URL, must match how objects are served (no trailing slash).
# CDN_R2_SECRET_ACCESS_KEY can be omitted if CDN_API_KEY already holds the R2 secret access key.
CDN_ACCOUNT_ID=
CDN_R2_BUCKET=
CDN_R2_ACCESS_KEY_ID=
# CDN_R2_SECRET_ACCESS_KEY=
CDN_R2_PUBLIC_BASE_URL=
# optional cap for multipart uploads (default 50)
# CDN_UPLOAD_MAX_BYTES_MB=50
#
# Without R2: Cloudflare Images accepts image/* only (same CDN_ACCOUNT_ID + CDN_API_KEY).

# Allow the browser setup wizard to write this file (local dev only; keep false in production)
ALLOW_SETUP_ENV_WRITE=true

# --- Gmail (single mailbox; optional OAuth) ---
# In the SAME Google Cloud project as the OAuth client below, enable the Gmail API:
#   APIs & Services → Library → search "Gmail API" → Enable
# (Otherwise OAuth works but calls to gmail.googleapis.com return 403 SERVICE_DISABLED.)
# OAuth scopes used by the app: https://www.googleapis.com/auth/gmail.send
#   and https://www.googleapis.com/auth/gmail.modify (read + labels + send-side operations).
# Add both under APIs & Services → OAuth consent screen → Scopes, then reconnect if you change scopes.
# Create an OAuth 2.0 Web client in Google Cloud Console. Authorized redirect URI must match how the UI is opened:
#   {origin}/api/oauth/google/callback   e.g. http://localhost:5173/api/oauth/google/callback (Vite proxies /api → API)
# Override only if your reverse proxy uses a different callback path:
# GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Written after "Connect Gmail" when ALLOW_SETUP_ENV_WRITE=true. Docker needs ../backend/.env mounted at /app/.env or the token stays only in the container layer.
GOOGLE_REFRESH_TOKEN=
# CLI (client id/secret already in .env): cd backend && python scripts/fetch_google_refresh_token.py
# Register redirect http://127.0.0.1:8765/oauth2/callback on the same OAuth Web client (see script header).
# Optional; defaults to a hash of DATABASE_URL if unset (set explicitly in multi-instance deployments):
# OAUTH_STATE_SECRET=
#
# "Send mail as" (same Gmail account / OAuth): optional From address. It must appear EXACTLY in Gmail under
# Settings → See all settings → Accounts and import → Send mail as (added + verified). POP/SMTP-only accounts
# do not count until added there. Debug: GET /setup/gmail-send-as-list after connecting Gmail.
# GMAIL_SEND_AS_EMAIL=you@company.com

# Background Gmail sync (threads + bounces): interval in seconds. Set 0 to disable; use POST /gmail-sync/* from cron instead.
# GMAIL_SYNC_INTERVAL_SECONDS=120

# collect_companies: verify each proposed website with an HTTP GET (stream prefix). Drops rows that do not respond.
# COLLECT_COMPANIES_HTTP_CHECK_ENABLED=true
# COLLECT_COMPANIES_HTTP_TIMEOUT_SEC=8
# COLLECT_COMPANIES_HTTP_MAX_WORKERS=8

# --- Apollo.io (optional) — when set, collect_companies / find_contacts use Apollo instead of the LLM for discovery.
# Master API key from Apollo Settings → API. Env alias: APOLLO_KEY also works.
# APOLLO_API_KEY=
# APOLLO_HTTP_TIMEOUT_SEC=45
# APOLLO_MAX_ORG_PAGE_SIZE=50
# APOLLO_MAX_PEOPLE_PER_COMPANY=8
# APOLLO_MAX_PEOPLE_TOTAL=120

# --- Firmographics provider (Phase 6): drives the ICP employee-count filter ---
# Dadata token (Расширенный tier returns employee_count from the FNS ССЧ registry + OKVED).
# Without it the size gate stays inert (unknown size is never a reject). Keep this in .env ONLY.
# DADATA_API_KEY=
# DADATA_HTTP_TIMEOUT_SEC=10
# FIRMOGRAPHICS_PROVIDER_PRIORITY=dadata,egrul_free

# --- Web search provider (R4): Yandex Cloud Search API = real yandex.ru index (sees VK/Telegram/
# regional RU press that US-indexed Tavily misses). Yandex primary for RU, Tavily fallback.
# Get from Yandex Cloud: service account + role search-api.webSearch.user + active billing.
# Keep in .env ONLY (gitignored). folder_id is required on every request.
# YANDEX_SEARCH_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_SEARCH_REGION=225
# SEARCH_PROVIDER_PRIORITY=yandex,tavily

# --- Outbound email behaviour ---
# false: do not fake-deliver (recommended — errors if Gmail is not configured). true: mock provider without Gmail (offline only).
EMAIL_ALLOW_MOCK=false
# Legacy: shown in setup/status; Drafts → Test sends To = From (GMAIL_SEND_AS_EMAIL or primary Gmail), not this variable.
# GMAIL_PREVIEW_RECIPIENT_EMAIL=
